#!/usr/bin/env bash

set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    echo "ambed-usb-unbind must be run as root" >&2
    exit 1
fi

FTDI_DRIVER="/sys/bus/usb/drivers/ftdi_sio"

SUPPORTED_PRODUCTS=(
    "USB-3000"
    "DVstick-30"
    "ThumbDV"
    "USB-3003"
    "DF2ET-3003"
    "DVstick-33"
    "ThumbDV-3"
    "USB-3006 A"
    "USB-3012 A"
)

is_supported_product()
{
    local product="$1"

    for supported in "${SUPPORTED_PRODUCTS[@]}"; do
        [[ "$product" == "$supported" ]] && return 0
    done

    return 1
}

for dev in /sys/bus/usb/devices/*; do
    [[ -f "$dev/idVendor" ]] || continue
    [[ -f "$dev/product" ]] || continue

    # AMBEd currently uses FTDI-based vocoder interfaces.
    [[ "$(<"$dev/idVendor")" == "0403" ]] || continue

    product="$(<"$dev/product")"

    is_supported_product "$product" || continue

    serial="unknown"
    [[ -f "$dev/serial" ]] && serial="$(<"$dev/serial")"

    for intf in "$dev":*; do
        [[ -e "$intf" ]] || continue
        [[ -L "$intf/driver" ]] || continue

        driver="$(basename "$(readlink -f "$intf/driver")")"

        [[ "$driver" == "ftdi_sio" ]] || continue

        iface="$(basename "$intf")"

        echo "Unbinding $product ($serial) from $iface"
        printf '%s' "$iface" > "$FTDI_DRIVER/unbind"
    done
done
